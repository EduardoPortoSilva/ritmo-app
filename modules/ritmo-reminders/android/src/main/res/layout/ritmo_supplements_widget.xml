<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/supplement_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="13dp"
  android:paddingVertical="7dp" android:background="@drawable/supplement_widget_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:text="ritmo." android:textSize="14sp" android:textStyle="bold" android:textColor="#243D32"
      android:includeFontPadding="false" />
    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
      android:layout_marginStart="5dp" android:text="&#183; Suplementos" android:textSize="13sp"
      android:textColor="#647269" android:maxLines="1" android:ellipsize="end"
      android:includeFontPadding="false" />
    <TextView android:id="@+id/supplement_widget_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:text="1/3" android:textSize="14sp" android:textStyle="bold" android:textColor="#647269"
      android:includeFontPadding="false" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="4dp" android:gravity="center_vertical">
    <TextView android:id="@+id/supplement_widget_summary" android:layout_width="0dp" android:layout_weight="1"
      android:layout_height="wrap_content" android:text="Faltam: Creatina e Whey"
      android:textSize="17sp" android:textStyle="bold" android:textColor="#243D32"
      android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    <TextView android:id="@+id/supplement_widget_extra" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginStart="5dp" android:text="+1" android:textSize="15sp" android:textStyle="bold"
      android:textColor="#243D32" android:includeFontPadding="false" android:visibility="gone" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginStart="5dp" android:text="&#8250;" android:textSize="25sp"
      android:textColor="#647269" android:includeFontPadding="false" android:importantForAccessibility="no" />
  </LinearLayout>
</LinearLayout>
