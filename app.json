{
  "expo": {
    "name": "Ritmo",
    "slug": "ritmo-treinos",
    "scheme": "ritmo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#243D32"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ritmo.treinos",
      "versionCode": 4,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Ritmo — seu espaço de treino",
      "shortName": "Ritmo",
      "description": "Suas rotinas e cada série do seu treino, em um só lugar."
    },
    "plugins": ["expo-font", "expo-sharing", "./plugins/withRitmoAndroidSecurity"]
  }
}
